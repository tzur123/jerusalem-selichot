# Copy to .env.local and fill in real values before deploying to production.
# In local development, leaving the Supabase / Google Maps values empty is
# supported: the app automatically falls back to an in-memory mock backend
# and a graceful "map unavailable" UI so the full flow can still be reviewed.

# Public app URL (used for metadata, QR deep links, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser bundle
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps JavaScript API key, restricted by HTTP referrer + Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Random long secrets used to hash visitor session cookies and QR tokens.
# Generate with: openssl rand -base64 32
SESSION_HASH_SECRET=
QR_HASH_PEPPER=

# Only used when Supabase is NOT configured (local mock-backend admin login).
# Ignored once Supabase Auth is wired up — create a real admin user instead.
ADMIN_MOCK_EMAIL=admin@example.com
ADMIN_MOCK_PASSWORD=admin1234
